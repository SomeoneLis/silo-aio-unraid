#!/command/with-contenv bash
set -e

# Ensure postgres user and group exist in system
if ! id -u postgres >/dev/null 2>&1; then
    groupadd -r postgres 2>/dev/null || true
    useradd -r -g postgres -d /var/lib/silo/postgres -s /bin/bash postgres
fi

export PATH="/usr/lib/postgresql/18/bin:/app:$PATH"
export PORT="${PORT:-8090}"
PGBIN="/usr/lib/postgresql/18/bin"
PGDATA="/var/lib/silo/postgres"

mkdir -p /var/lib/silo/postgres /var/lib/silo/redis /var/lib/silo/meilisearch /var/lib/silo/logs

# --- Helper: generate-or-load a persisted secret file (alphanumeric only) ---
load_or_create_key() {
    local file="$1" length="$2" override="$3" val
    if [ -f "$file" ] && [ -s "$file" ]; then
        val="$(tr -d '\r\n' < "$file")"
    elif [ -n "$override" ]; then
        val="$override"
        printf '%s' "$val" > "$file"
    else
        val="$(tr -dc A-Za-z0-9 </dev/urandom | head -c "$length")"
        printf '%s' "$val" > "$file"
    fi
    chmod 600 "$file" 2>/dev/null || true
    printf '%s' "$val"
}

SECRET_KEY="$(load_or_create_key /var/lib/silo/secret.key 48 "$SECRET_KEY")"
MEILI_MASTER_KEY="$(load_or_create_key /var/lib/silo/meili.key 48 "$MEILI_MASTER_KEY")"
PG_PASSWORD="$(load_or_create_key /var/lib/silo/pgpass.key 32 "$PG_PASSWORD")"
PG_SUPER_PASSWORD="$(load_or_create_key /var/lib/silo/pgsuper.key 32 "$PG_SUPER_PASSWORD")"

# --- Write runtime environment ---
RUNTIME_ENV="/var/lib/silo/.runtime-env"
cat > "$RUNTIME_ENV" <<EOF
export SECRET_KEY='${SECRET_KEY}'
export MEILI_MASTER_KEY='${MEILI_MASTER_KEY}'
export DATABASE_URL='postgres://silo:${PG_PASSWORD}@127.0.0.1:5432/silo?sslmode=disable'
export REDIS_URL='${REDIS_URL:-redis://127.0.0.1:6379}'
export PORT='${PORT:-8090}'
EOF
chmod 600 "$RUNTIME_ENV" 2>/dev/null || true

# --- Ownership ---
chown postgres:postgres /var/lib/silo /var/lib/silo/postgres \
    /var/lib/silo/redis /var/lib/silo/meilisearch /var/lib/silo/logs 2>/dev/null || true
if [ "$(stat -c '%U' "$PGDATA" 2>/dev/null)" != "postgres" ]; then
    chown -R postgres:postgres "$PGDATA"
fi

# Truncate PostgreSQL log if larger than 50MB
PG_LOG="$PGDATA/logfile"
if [ -f "$PG_LOG" ] && [ "$(stat -c%s "$PG_LOG" 2>/dev/null || echo 0)" -gt 52428800 ]; then
    echo "PostgreSQL log exceeds 50MB. Truncating..."
    tail -n 1000 "$PG_LOG" > "${PG_LOG}.tmp" && mv "${PG_LOG}.tmp" "$PG_LOG"
    chown postgres:postgres "$PG_LOG"
fi

# Initialize PostgreSQL 18 with scram-sha-256 auth and superuser pwfile on first run
if [ ! -f "$PGDATA/PG_VERSION" ]; then
    echo "No valid database cluster found. Initializing PostgreSQL (scram-sha-256 auth)..."
    rm -rf "$PGDATA"/* "$PGDATA"/.* 2>/dev/null || true
    chown -R postgres:postgres "$PGDATA"
    PWFILE="/tmp/.pgpass_init"
    printf '%s' "$PG_SUPER_PASSWORD" > "$PWFILE"
    chown postgres:postgres "$PWFILE"
    chmod 600 "$PWFILE"
    su postgres -c "$PGBIN/initdb -D $PGDATA --locale=C.UTF-8 --encoding=UTF8 \
        --auth-local=scram-sha-256 --auth-host=scram-sha-256 --pwfile=$PWFILE"
    rm -f "$PWFILE"
fi

# --- Enforce hardened pg_hba.conf ---
HBA="$PGDATA/pg_hba.conf"
cat > "$HBA" <<'EOF'
# Managed by silo-aio init. Password auth only; loopback-only.
local   all             all                                     scram-sha-256
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256
EOF
chown postgres:postgres "$HBA"
chmod 600 "$HBA"

# Ensure password encryption is scram in postgresql.conf
if ! grep -q "^password_encryption = scram-sha-256" "$PGDATA/postgresql.conf" 2>/dev/null; then
    echo "password_encryption = scram-sha-256" >> "$PGDATA/postgresql.conf"
fi

# Start PG temporarily to provision roles/db/extensions, then stop it
su postgres -c "$PGBIN/pg_ctl -D $PGDATA -l $PGDATA/logfile -w start"

until "$PGBIN/pg_isready" -h 127.0.0.1 -p 5432; do
  echo "Waiting for PostgreSQL database..."
  sleep 1
done

# Provision roles/database using PGPASSWORD
export PGPASSWORD="$PG_SUPER_PASSWORD"
PSQL_SUPER="$PGBIN/psql -h 127.0.0.1 -U postgres"

# --- Provision the 'silo' role ---
if ! su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -tAc \"SELECT 1 FROM pg_roles WHERE rolname='silo';\"" 2>/dev/null | grep -q 1; then
    echo "Creating 'silo' role..."
    su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -c \"CREATE USER silo WITH PASSWORD '${PG_PASSWORD}';\""
fi
su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -c \"ALTER USER silo WITH PASSWORD '${PG_PASSWORD}';\""

# --- Provision database ---
if ! su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -tAc \"SELECT 1 FROM pg_database WHERE datname='silo';\"" 2>/dev/null | grep -q 1; then
    echo "Creating 'silo' database..."
    su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -c \"CREATE DATABASE silo OWNER silo;\""
fi

# --- Wait until database accepts connections ---
until su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -d silo -c 'SELECT 1;'" >/dev/null 2>&1; do
    echo "Waiting for 'silo' database to become available..."
    sleep 1
done

# --- Extensions and cleanup ---
su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -d silo -c \"CREATE EXTENSION IF NOT EXISTS vector; CREATE EXTENSION IF NOT EXISTS citext;\"" || echo "WARNING: extension creation returned non-zero."
su postgres -c "PGPASSWORD='$PG_SUPER_PASSWORD' $PSQL_SUPER -d silo -c \"DELETE FROM settings WHERE key = 'notifications.web_push.vapid_keypair';\"" 2>/dev/null || true

su postgres -c "$PGBIN/pg_ctl -D $PGDATA -m fast -w stop"

echo "Init complete."
