#!/command/with-contenv bash
# Load the resolved runtime environment written by 10-silo-init.
[ -f /var/lib/silo/.runtime-env ] && . /var/lib/silo/.runtime-env

INJECT_LOG="/var/lib/silo/logs/meili-inject.log"
PSQL="/usr/lib/postgresql/18/bin/psql"

# Connect as the 'silo' role to the 'silo' DB over TCP, using the same password
# the app uses. Parsed out of DATABASE_URL so there's a single source of truth.
# DATABASE_URL format: postgres://silo:<password>@127.0.0.1:5432/silo?sslmode=disable
PG_PASSWORD="$(printf '%s' "$DATABASE_URL" | sed -E 's#^postgres://silo:([^@]+)@.*#\1#')"
export PGPASSWORD="$PG_PASSWORD"

run_psql() {
  "$PSQL" -h 127.0.0.1 -U silo -d silo "$@"
}

for i in $(seq 1 40); do
  sleep 3
  # Wait until Silo's migrations have created the settings table.
  if run_psql -tAc "SELECT to_regclass('public.settings');" 2>/dev/null | grep -q '^settings$'; then
    if run_psql -c "
      INSERT INTO settings (key, value)
      VALUES
        ('search.provider', 'meilisearch'),
        ('search.meili_url', 'http://127.0.0.1:7700'),
        ('search.meili_key', '${MEILI_MASTER_KEY}')
      ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value;
    " >>"$INJECT_LOG" 2>&1; then
      echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') Meilisearch settings injected successfully." >>"$INJECT_LOG"
    else
      echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') WARNING: settings table present but injection failed (schema change?)." >>"$INJECT_LOG"
    fi
    break
  fi
  if [ "$i" -eq 40 ]; then
    echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') WARNING: settings table never appeared after 120s." >>"$INJECT_LOG"
  fi
done

# Keep the service alive so s6 doesn't treat exit as a crash and restart the loop.
exec sleep infinity
